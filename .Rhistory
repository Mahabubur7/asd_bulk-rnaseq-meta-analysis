# Add 95% CI columns from log2FC ± 1.96*lfcSE to each study before merging
studies <- lapply(studies, function(df) {
df$CI.L <- df$log2FoldChange - 1.96 * df$lfcSE
df$CI.R <- df$log2FoldChange + 1.96 * df$lfcSE
df
})
meta_degs_rem <- rem_mv(
diffexp       = studies,
pcriteria     = "padj",
foldchangecol = "log2FoldChange",
genenamecol   = "Gene_ID",
geneidcol     = NULL,
collaps       = TRUE,
llcol         = "CI.L",
rlcol         = "CI.R",
vcol          = NULL,
cvar          = TRUE,
metathr       = 0.01,
jobname       = "MetaVolcano_REM_ASD",
outputfolder  = "results/figures/meta-analysis/",
draw          = "PDF",
ncores        = 1
)
print(MetaVolcanoR::collapse_deg)
print(MetaVolcanoR::rename_col)
sapply(studies, function(df) "Gene_ID" %in% colnames(df))
sapply(studies, function(df) sum(duplicated(df$Gene_ID)))
genenamecol <- "Gene_ID"
foldchangecol <- "log2FoldChange"
llcol <- "CI.L"
rlcol <- "CI.R"
# Step 1: replicate cvar=TRUE step (calc_vi adds a "vi" column)
diffexp <- lapply(studies, function(...) MetaVolcanoR::calc_vi(..., llcol, rlcol))
lapply(diffexp, colnames)   # <-- check: does "Gene_ID" survive here?
# Step 2: collapse_deg
diffexp <- lapply(diffexp, function(g) MetaVolcanoR::collapse_deg(g, genenamecol, "padj"))
lapply(diffexp, colnames)   # <-- check again
# Step 3: select relevant columns
vcol <- "vi"
diffexp <- lapply(diffexp, function(...) dplyr::select(..., dplyr::matches(paste(c(genenamecol, foldchangecol, llcol, rlcol, vcol), collapse = '|'))))
lapply(diffexp, colnames)   # <-- check again
# Step 4: rename_col
diffexp <- MetaVolcanoR::rename_col(diffexp, genenamecol)
lapply(diffexp, colnames)   # <-- this is the critical one — does "Gene_ID" exist in BOTH?
meta_diffexp <- Reduce(function(...) merge(..., by = genenamecol, all = TRUE), diffexp)
dim(meta_diffexp)
head(meta_diffexp)
library(metafor)
# meta_diffexp already has: Gene_ID, log2FoldChange_1/_2, CI.L_1/_2, CI.R_1/_2, vi_1/_2
run_rem_gene <- function(row) {
fc <- c(row["log2FoldChange_1"], row["log2FoldChange_2"])
vi <- c(row["vi_1"], row["vi_2"])
keep <- !is.na(fc) & !is.na(vi)
fc <- as.numeric(fc[keep]); vi <- as.numeric(vi[keep])
if (length(fc) < 2) {
return(c(randomSummary = NA, randomP = NA, randomCi.lb = NA, randomCi.ub = NA))
}
fit <- tryCatch(metafor::rma(yi = fc, vi = vi, method = "REML"),
error = function(e) NULL)
if (is.null(fit)) return(c(randomSummary = NA, randomP = NA, randomCi.lb = NA, randomCi.ub = NA))
c(randomSummary = as.numeric(fit$beta), randomP = fit$pval,
randomCi.lb = fit$ci.lb, randomCi.ub = fit$ci.ub)
}
rem_results <- t(apply(meta_diffexp, 1, run_rem_gene))
meta_results <- cbind(meta_diffexp["Gene_ID"], as.data.frame(rem_results))
head(meta_results)
nrow(meta_results)
sum(!is.na(meta_results$randomP))
sum(!is.na(meta_results$randomP) & meta_results$randomP < 0.05 & abs(meta_results$randomSummary) >= 1)
annotated_results <- annotate_genes(meta_results)
export(annotated_results, "results/tables/meta-analysis/random_effect_model.csv")
key_genes <- annotated_results |>
filter(randomP < 0.05, abs(randomSummary) >= 1)
export(key_genes, "results/tables/meta-analysis/filtered_meta_degs.csv")
